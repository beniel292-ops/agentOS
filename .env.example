# Copy to .env and fill in. Never commit .env. Never paste keys into chat.

# ---------- AgentOS (MVP) ----------
# ANTHROPIC_API_KEY=         # optional, later (console.anthropic.com -> API keys)
DATABASE_URL=postgresql+psycopg://agentos:agentos@localhost:5434/agentos
REDIS_URL=redis://localhost:6380/0
# AI via OmniRoute (OpenAI-compatible)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
AI_MODEL=agy/gemini-3.8-flash-high
AI_FALLBACK_MODELS=["kr/claude-haiku-4.5","agy/gemini-3.8-flash-medium"]
RESEND_API_KEY=               # resend.com -> API keys
RESEND_FROM=replies@yourdomain.com
CLERK_SECRET_KEY=             # clerk.com -> API keys (backend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
SENTRY_DSN=                   # optional in dev
# Telegram approvals + Chief of Staff bot (dedicated bot; empty token = Telegram off)
TELEGRAM_APPROVALS_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_TENANT_ID=
WEB_APP_URL=http://localhost:3000
# OpenClaw inbound webhook (approved voice-call requests go to Jarvis); empty token = off
OPENCLAW_HOOKS_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_HOOKS_TOKEN=

# Voice calls (Chief of Staff): the worker dials through agentring; the voice AI's tools are the
# MCP server (make dev starts it on 127.0.0.1:8787) which calls this API with a scoped key:
#   uv run python -m scripts.create_agent_key --tenant <uuid> --name voice \
#     --scopes tasks:read,tasks:write,callbacks:write,memory:write,stop
VOICE_AGENT_KEY=
VOICE_PROVIDER=local
VOICE_MCP_URL=http://127.0.0.1:8787/mcp
VOICE_AGENTOS_API_URL=http://127.0.0.1:8000
AGENTRING_BIN=                # default: the audited agentring clone's .venv/bin/agentring
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Jarvis layer (OpenClaw + Hermes, in Docker) ----------
# Both agents use OmniRoute as their LLM gateway (OpenAI-compatible).
# Inside Docker, "localhost" is the container, so use host.docker.internal.
# (jarvis/.env uses OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1)
JARVIS_MODEL=                 # e.g. the Claude model name as OmniRoute exposes it

TELEGRAM_BOT_TOKEN_OPENCLAW=  # @BotFather -> /newbot (bot 1: Jarvis front door)
TELEGRAM_BOT_TOKEN_HERMES=    # @BotFather -> /newbot (bot 2: automations + reports)
TELEGRAM_ALLOWED_USER_ID=     # your numeric Telegram id (from @userinfobot)

AGENTOS_API_URL=http://host.docker.internal:8000
AGENTOS_AGENT_KEY=            # scoped key AgentOS creates for the agents (read + draft only)

# Copy to .env and fill in. Never commit .env. Never paste keys into chat.

# ---------- AgentOS (MVP) ----------
# ANTHROPIC_API_KEY=         # optional, later (console.anthropic.com -> API keys)
DATABASE_URL=postgresql+psycopg://agentos:agentos@localhost:5434/agentos
REDIS_URL=redis://localhost:6380/0
# AI via OmniRoute (OpenAI-compatible)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
AI_MODEL=agy/gemini-3.8-flash-high
RESEND_API_KEY=               # resend.com -> API keys
RESEND_FROM=replies@yourdomain.com
CLERK_SECRET_KEY=             # clerk.com -> API keys (backend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
SENTRY_DSN=                   # optional in dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Jarvis layer (OpenClaw + Hermes, in Docker) ----------
# Both agents use OmniRoute as their LLM gateway (OpenAI-compatible).
# Inside Docker, "localhost" is the container, so use host.docker.internal.
# (jarvis/.env uses OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1)
JARVIS_MODEL=                 # e.g. the Claude model name as OmniRoute exposes it

TELEGRAM_BOT_TOKEN_OPENCLAW=  # @BotFather -> /newbot (bot 1: Jarvis front door)
TELEGRAM_BOT_TOKEN_HERMES=    # @BotFather -> /newbot (bot 2: automations + reports)
TELEGRAM_ALLOWED_USER_ID=     # your numeric Telegram id (from @userinfobot)

AGENTOS_API_URL=http://host.docker.internal:8000
AGENTOS_AGENT_KEY=            # scoped key AgentOS creates for the agents (read + draft only)
